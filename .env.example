# Copy to .env and set secrets locally. Never commit .env.
APP_ENV=development
APP_PORT=8080
SITE_URL=http://127.0.0.1:8088
DATABASE_URL=postgres://devstore:REPLACE_PASSWORD@postgres:5432/devstore
POSTGRES_PASSWORD=REPLACE_PASSWORD
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=REPLACE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_SECRET_KEY
S3_BUCKET=devstore
CLAMAV_ADDR=clamav:3310
TRUSTED_PROXIES=
