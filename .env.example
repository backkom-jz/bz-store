# Copy to .env and set secrets locally. Never commit .env.
APP_ENV=development
APP_PORT=8080
SITE_URL=http://bz-store.local
DATABASE_URL=mysql://devstore:REPLACE_PASSWORD@RDS_HOST:3306/bz_ztore
# Set this separately for integration tests; it must never point at bz_ztore or ERP.
MYSQL_TEST_DATABASE_URL=mysql://test_user:ROTATE_AND_SET@RDS_TEST_HOST:3306/bz_ztore_test
REDIS_URL=redis://redis:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
S3_ENDPOINT=http://storage:9000
S3_ACCESS_KEY=REPLACE_ACCESS_KEY
S3_SECRET_KEY=REPLACE_SECRET_KEY
S3_BUCKET=devstore
# Aliyun OSS regional endpoints reject path-style. Leave these unset for MinIO.
# S3_REGION=oss-cn-shanghai
# S3_VIRTUAL_HOSTED=true
TRUSTED_PROXIES=
# Optional until an SMTP provider is selected. Production registration/reset stays unavailable without these.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=DevStore <noreply@example.com>
# Generate a separate 32-byte key with: openssl rand -base64 32
# EMAIL_OUTBOX_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
# Generate a different key with: openssl rand -base64 32
# MFA_ENCRYPTION_KEY=BASE64_32_BYTE_KEY
